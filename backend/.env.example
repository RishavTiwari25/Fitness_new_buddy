# Backend environment variables
# Copy this file to .env and adjust values as needed

# Server
PORT=4000
HOST=0.0.0.0

# JWT secret for signing tokens (change in production)
JWT_SECRET=change_me_in_production

# Optional: custom path for SQLite database file
# Path is resolved relative to the project root (process.cwd())
## On Render free tier consider using /tmp/db.sqlite (ephemeral)
# DB_FILE=backend/db.sqlite

# MongoDB Atlas (planned migration)
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.kdiua7h.mongodb.net/fitness?retryWrites=true&w=majority

# Optional: CORS allowed origin (leave empty for permissive dev CORS)
# CORS_ORIGIN=http://localhost:5173

# --- Google Gemini (powers ALL AI features) ---
# API key for Google Generative AI (Gemini). Required for: diet analysis,
# AI Coach chat, weekly insights, semantic equipment search, and NL booking.
# Get a key at https://aistudio.google.com/app/apikey
# (GEMINI_API_KEY / GOOGLE_GENERATIVE_AI_API_KEY are also accepted.)
GOOGLE_API_KEY=
# Chat/generation model (semantic search always uses gemini-embedding-001).
GOOGLE_GEMINI_MODEL=gemini-2.5-flash

# --- Stripe payments (membership fees) ---
# Get keys at https://dashboard.stripe.com/apikeys (use test keys first: sk_test_...).
# Webhook secret from `stripe listen` or the Dashboard webhook (whsec_...).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Currency for checkout (default inr). PUBLIC_URL is the site origin used for
# Stripe success/cancel redirects when the request Origin header is absent.
#STRIPE_CURRENCY=inr
#PUBLIC_URL=https://your-frontend.vercel.app

# --- Weekly AI insights cron ---
# Cron expression (default Monday 08:00). Set DISABLE_CRON=1 to turn it off.
#WEEKLY_INSIGHTS_CRON=0 8 * * 1
#DISABLE_CRON=0

# --- Cloud uploads (Cloudinary) ---
# Use Cloudinary for images in posts/avatars when set.
# Either specify a single URL, or the three fields below. NEVER commit real secrets.
# Example URL format: cloudinary://<api_key>:<api_secret>@<cloud_name>
#CLOUDINARY_URL=
#CLOUDINARY_CLOUD_NAME=
#CLOUDINARY_API_KEY=
#CLOUDINARY_API_SECRET=

# Fallback local uploads directory when not using Cloudinary
## On Render free tier consider using /tmp/uploads (ephemeral)
#UPLOADS_DIR=backend/uploads
